{
    "@base": "http://localhost:8000/",
    "@context": {
        "idx": "https://ns.inria.fr/idx/terms#",
        "sh": "http://www.w3.org/ns/shacl#",
        "ex": "http://example.org#",
        "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
        "sh:path": {
            "@type": "@id"
        },
        "idx:hasSubIndex": {
            "@type": "@id"
        },
        "idx:hasShape": {
            "@type": "@id"
        }
    },
    "@graph": [
        {
            "@type": "idx:Index",
            "@id": "root"
        },
        {
            "@id": "root#target",
            "sh:path": "rdf:type",
            "sh:hasValue": {
                "@id": "ex:User"
            }
        },
        {
            "@id": "root#name",
            "@type": "idx:IndexEntry",
            "idx:hasShape": {
                "@type": "sh:NodeShape",
                "sh:closed": "false",
                "sh:property": [
                    {
                        "@id": "root#target"
                    },
                    {
                        "sh:path": "ex:name"
                    }
                ]
            },
            "idx:hasSubIndex": "name"
        },
        {
            "@id": "root#skills",
            "@type": "idx:IndexEntry",
            "idx:hasShape": {
                "@type": "sh:NodeShape",
                "sh:closed": "false",
                "sh:property": [
                    {
                        "@id": "root#target"
                    },
                    {
                        "sh:path": "ex:skills"
                    }
                ]
            },
            "idx:hasSubIndex": "skills"
        }
    ]
}